package rk:plc@0.1.0;

/// What a host calls to run a PLC compiled by rk.
///
/// A host reads the component's `rk.schedule` section to know which tasks
/// are due, and calls `run-task` for each of them, in the order the section
/// lists them.
interface control {
    /// Writes the starting value of every variable. Called once, before
    /// anything else; a warm start then gives the retained values back with
    /// `restore-retain`. The error is the message of an exception a starting
    /// value raised.
    init: func() -> result<_, string>;

    /// Why a scan did not run to its end.
    variant scan-error {
        /// The message of the exception that stopped it.
        raised(string),
        /// No task is at that place in the `rk.schedule` section.
        no-such-task,
    }

    /// Runs the task at that place in the `rk.schedule` section. `inputs` is
    /// copied into the input area, as much of it as the area holds, then each
    /// program instance of the task runs, in order. Returns the output area.
    run-task: func(task: u32, inputs: list<u8>) -> result<list<u8>, scan-error>;

    /// The retain area, to keep across a power cycle.
    save-retain: func() -> list<u8>;

    /// Gives the retain area back, as many bytes as it holds.
    restore-retain: func(retained: list<u8>);

    /// A run of bytes in the module's memory: a variable's address and size,
    /// as the `debug-symbols` section gives them.
    record range {
        address: u32,
        size: u32,
    }

    /// Why a host's read or write of the memory was refused.
    variant memory-error {
        /// The range at that place in the list is outside the memory.
        outside-memory(u32),
        /// The ranges together are more than the memory can hold.
        too-large,
        /// The bytes would not all land in the variables.
        outside-variables,
    }

    /// The bytes of each range, one range after the other, as they stand
    /// between two calls.
    read-memory: func(ranges: list<range>) -> result<list<u8>, memory-error>;

    /// Writes `bytes` at `address`, where the next scan finds them. Refused
    /// anywhere but the variables: the module's own data, its string
    /// literals and its stack are not a host's to write. The bytes must be a
    /// value of the variable's type, which the module does not check.
    write-memory: func(address: u32, bytes: list<u8>) -> result<_, memory-error>;

    /// Why a test did not pass.
    variant test-error {
        /// The message it failed with.
        failed(string),
        /// No test is at that place in the `test-manifest` section. A release
        /// build runs none.
        no-such-test,
    }

    /// Where a test stands after a call of `run-test`.
    enum test-state {
        /// It passed: a test FUNCTION when it returns, a test FUNCTION_BLOCK
        /// when a cycle leaves its `DONE` TRUE.
        passed,
        /// A test FUNCTION_BLOCK whose `DONE` is still FALSE: the next call
        /// runs its next cycle.
        running,
    }

    /// Runs the test at that place in the `test-manifest` section: a test
    /// FUNCTION whole, or one cycle of a test FUNCTION_BLOCK, on an instance
    /// the test keeps from one call to the next.
    run-test: func(test: u32) -> result<test-state, test-error>;
}
