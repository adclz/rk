{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "rk",
      "camelcase": "Rk",
      "title": "Rk",
      "scope": "source.rk",
      "file-types": [
        ".st"
      ],
      "injection-regex": "^rk$",
      "class-name": "TreeSitterRk"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "AGPL-3.0-only",
    "description": "Structured Text grammar for tree-sitter",
    "authors": [
      {
        "name": "CLAUZEL Adrien",
        "email": "clauzeladrien@mail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/adclz/rk"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}