{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "extensionHost",
			"request": "launch",
			"name": "Release",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}/vscode",
				"${workspaceFolder}/vscode/test"
			],
			"outFiles": [
				"${workspaceFolder}/vscode/client/out/**/*.js"
			],
			"preLaunchTask": "Build All"
		},
		{
			"type": "extensionHost",
			"request": "launch",
			"name": "Debug Extension",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}/vscode",
				"${workspaceFolder}/vscode/test"
			],
			"outFiles": [
				"${workspaceFolder}/vscode/client/out/**/*.js"
			],
			"preLaunchTask": "Build All",
			"env": {
				"RUST_LOG": "info",
				"RUST_BACKTRACE": "1"
			}
		}
	]
}
