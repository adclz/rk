{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "build",
			"label": "npm: build native",
			"path": "/vscode"
		},
		{
			"type": "shell",
			"label": "Build LSP Server (Debug)",
			"command": "cargo build --bin vscode-lsp-server && rm -f ${workspaceFolder}/vscode/server/bin/vscode-lsp-server && cp ${workspaceFolder}/target/debug/vscode-lsp-server ${workspaceFolder}/vscode/server/bin/vscode-lsp-server",
			"group": "build",
			"options": {
				"cwd": "${workspaceFolder}/vscode/server"
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": ["$rustc"]
		},
		{
			"label": "Build All",
			"dependsOn": ["npm: build native", "Build LSP Server (Debug)"],
			"dependsOrder": "parallel",
			"problemMatcher": []
		}
	]
}
