{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rk-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  // Everything under dist/ is generated by `cargo run --release -p doc`.
  // The Worker runs first so it can answer `Accept: text/markdown` and set
  // headers on every response; it hands anything else to the assets.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
