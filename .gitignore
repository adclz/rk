# The root Cargo.lock is TRACKED for CI
# Only the excluded crate's generated lock stays ignored
/crates/wasm_builtins/Cargo.lock
/target
crates/wasm_builtins/target

# Generated documentation
crates/doc/out/

# Fuzzing
crates/fuzz/corpus/
crates/fuzz/artifacts/
crates/fuzz/crash-*
crates/fuzz/oom-*
crates/fuzz/slow-*

# Compiler Output
**/rk_build/

# Generated by wasm_builtins_generated's build.rs on every build - see its
# src/lib.rs, which has always documented it as gitignored. Tracking it only
# produced spurious diffs whenever the nightly toolchain's codegen reordered
# the wasm sections build.rs parses.
crates/wasm_builtins_generated/src/generated.rs

# IDE settings are personal, not project state
.idea/
*.iml
