	NAMESPACE Test
		USING Std.Unit
		USING Std.Memory

		{test}
		FUNCTION test_move_int
			VAR
				x: INT := 0;
			END_VAR
			MOVE(42, OUT => x);
			ASSERT_EQ(x, 42);
		END_FUNCTION

		{test}
		FUNCTION test_move_real
			VAR
				x: REAL := 0.0;
			END_VAR
			MOVE(3.14, OUT => x);
			ASSERT_EQ(x, 3.14);
		END_FUNCTION

		{test}
		FUNCTION test_move_bool
			VAR
				x: BOOL := FALSE;
			END_VAR
			MOVE(TRUE, OUT => x);
			ASSERT(x);
		END_FUNCTION
