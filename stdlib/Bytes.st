		{wasm IN 'bswap' (params IN) (result FROM_BIG_ENDIAN)}
	END_FUNCTION

	FUNCTION FROM_BIG_ENDIAN: LREAL
		VAR_INPUT
			IN: LREAL;
		END_VAR
		VAR
			bits: LWORD;
		END_VAR
		{wasm 'i64.reinterpret_f64' (params IN) (result bits)}
