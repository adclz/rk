{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Structured Text",
  "patterns": [
    {
      "include": "#system"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#meta"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#keywords"
    }
  ],
  "repository": {
    "system": {
      "patterns": [
        {
          "match": "\\n",
          "name": "meta.ending-space"
        },
        {
          "begin": "^(?=\\t)",
          "end": "(?=[^\\t])",
          "name": "meta.leading-space",
          "patterns": [
            {
              "match": "(\\t)(\\t)?",
              "captures": {
                "1": {
                  "name": "meta.odd-tab.tabs"
                },
                "2": {
                  "name": "meta.even-tab.tabs"
                }
              }
            }
          ]
        },
        {
          "begin": "^(?= )",
          "end": "(?=[^ ])",
          "name": "meta.leading-space",
          "patterns": [
            {
              "match": "(  )(  )?",
              "captures": {
                "1": {
                  "name": "meta.odd-tab.spaces"
                },
                "2": {
                  "name": "meta.even-tab.spaces"
                }
              }
            }
          ]
        },
        {
          "name": "storage.type.class.st",
          "match": "(?i)\\s*\\b(PROGRAM|FUNCTION_BLOCK|FUNCTION|TYPE)\\b\\s*(PRIVATE|PUBLIC|PROTECTED)?\\s*\\b([a-zA-Z_0-9]*)\\b",
          "captures": {
            "2": {
              "name": "storage.modifier.st"
            },
            "3": {
              "name": "entity.name.function.st"
            }
          }
        },
        {
          "name": "storage.type.namespace.st",
          "match": "(?i)\\s*\\b(NAMESPACE)\\b\\s*([a-zA-Z_0-9\\.]+)\\b",
          "captures": {
            "2": {
              "name": "entity.name.type.namespace"
            }
          }
        },
        {
          "name": "storage.type.class.st",
          "match": "(?i)\\s*\\b(CLASS)\\b\\s*([a-zA-Z_0-9]*)\\b",
          "captures": {
            "2": {
              "name": "entity.name.type.class"
            }
          }
        },
        {
          "name": "storage.type.interface.st",
          "match": "(?i)\\s*\\b(INTERFACE)\\b\\s*([a-zA-Z_0-9]*)\\b",
          "captures": {
            "2": {
              "name": "entity.name.type.interface"
            }
          }
        },
        {
          "name": "storage.type.class.st",
          "match": "(?i)\\s*\\b(EXTENDS|IMPLEMENTS)\\b\\s*\\b([a-zA-Z_0-9]*)\\b",
          "captures": {
            "2": {
              "name": "entity.name.function.st"
            }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.st",
          "match": "\\b(2#[0-9\\_]+)\\b"
        },
        {
          "name": "constant.numeric.hex.st",
          "match": "\\b(16#[0-9A-Fa-f\\_]+)\\b"
        },
        {
          "name": "constant.numeric.integer.st",
          "match": "\\b(8#[0-9\\_]+)\\b"
        },
        {
          "name": "constant.numeric.float.st",
          "match": "\\b\\d*\\.\\d+([eE][\\-+]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.st",
          "match": "\\b(\\d)+\\b"
        },
        {
          "name": "constant.numeric.integer.st",
          "match": "(?i)\\b(?:H)[0-9ABCDEF]+\\b"
        },
        {
          "name": "constant.numeric.integer.st",
          "match": "\\b(?:K)[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.st",
          "match": "(?i)\\b(BYTE|(?:D|L)?WORD|U?(?:S|D|L)?INT)#(2|8)#[0-9\\_]+\\b"
        },
        {
          "name": "constant.numeric.integer.st",
          "match": "(?i)\\b(BYTE|(?:D|L)?WORD|U?(?:S|D|L)?INT)#16#[a-fA-F0-9\\_]+\\b"
        },
        {
          "name": "constant.numeric.integer.st",
          "match": "(?i)\\b(BYTE|(?:D|L)?WORD|U?(?:S|D|L)?INT)#-?[0-9\\_]+\\b"
        },
        {
          "name": "constant.numeric.float.st",
          "match": "(?i)\\b(L?REAL)#-?\\d*\\.\\d+([eE][\\-+]?\\d+)?\\b"
        }
      ]
    },
    "controls": {
      "patterns": [
        {
          "name": "keyword.control.conditional.st",
          "match": "(?i)\\b(?:END_)?(?:IF|CASE|OF|ELSE|ELSIF|THEN|OR(_ELSE)?|AND(_THEN)?|NOT|XOR|NOR|__TRY|__CATCH|__FINALLY|__ENDTRY)\\b"
        },
        {
          "name": "keyword.control.loop.st",
          "match": "(?i)\\b(?:END_)?(?:WHILE|FOR|REPEAT|DO|TO|BY)\\b"
        },
        {
          "name": "keyword.control.flow.st",
          "match": "(?i)\\b(?:RETURN|EXIT|CONTINUE|GOTO|JMP|BEGIN|COUNTER|GOTO)\\b"
        },
        {
          "name": "keyword.control.st",
          "match": "(?i)\\b(END_)?(TASK|WITH|ON|USING|USES|FROM|UNTIL)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.range.st",
          "match": "(?<!\\.)\\.\\.(?!\\.)"
        },
        {
          "name": "keyword.operator.assignment.st",
          "match": "(:=|=>|S=|R=)"
        },
        {
          "name": "keyword.operator.content.st",
          "match": "(?i)\\^|MOVE"
        },
        {
          "name": "keyword.operator.comparison.st",
          "match": "(?:<>|<|=|>|<=|>=)"
        },
        {
          "name": "keyword.operator.arithmetic.st",
          "match": "(?i)(?:\\+|\\-|\\/|\\*|MOD)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.st",
          "match": "(?i)\\b[A-Za-z_]*(_TO_|TO_|FROM_|TRUNC_)[A-Za-z_]+(?=\\()"
        },
        {
          "begin": "(?i)([a-zA-Z_0-9]+)(\\()",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.st"
            },
            "2": {
              "name": "punctuation.parenthesis.begin.st"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.parenthesis.end.st"
            }
          },
          "patterns": [
            {
              "include": "$self"
            },
            {
              "match": "\\b(N|R0|S0|L|D|P|SD|DS|SL|T)\\b",
              "name": "variable.parameter.st",
              "comment": "Action parameters"
            },
            {
              "match": "\\b([a-zA-Z0-9_]+) *:?=>? *",
              "captures": {
                "1": {
                  "name": "variable.parameter.st"
                }
              }
            }
          ]
        },
        {
          "name": "punctuation.accessor.st",
          "match": "(?<!\\.)\\.(?!\\.)"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "comment": "Rule for OF in var declaration",
          "begin": "(?i)\\b(?:VAR(?:_(?:INPUT|OUTPUT|IN_OUT|TEMP|GLOBAL|ACCESS|EXTERNAL|INST|STAT))?|STRUCT|UNION)\\b",
          "beginCaptures": {
            "0": {
              "name": "entity.name.type.st"
            }
          },
          "end": "(?i)\\b(?:END_(?:VAR|STRUCT|UNION))\\b",
          "endCaptures": {
            "0": {
              "name": "entity.name.type.st"
            }
          },
          "patterns": [
            {
              "match": "(?i)\\b(OF)\\b",
              "name": "support.type.primitives.st"
            },
            {
              "match": "\\b([a-zA-Z0-9_]+) *: *\\b",
              "captures": {
                "1": {
                  "name": "variable.name.st"
                }
              }
            },
            {
              "include": "$self"
            }
          ]
        },
        {
          "comment": "Rule for GET SET PROPERTIES",
          "begin": "(?i)\\b(?:PROPERTY|PROPERTY_GET|PROPERTY_SET)\\b",
          "beginCaptures": {
            "0": {
              "name": "storage.type.class.st"
            }
          },
          "end": "(?i)\\b(?:END_PROPERTY)\\b",
          "endCaptures": {
            "0": {
              "name": "storage.type.class.st"
            }
          },
          "patterns": [
            {
              "match": "(?i)\\b(END_)?(GET|SET)\\b",
              "captures": {
                "0": {
                  "name": "entity.name.type.st"
                }
              }
            },
            {
              "include": "$self"
            }
          ]
        },
        {
          "include": "#controls"
        },
        {
          "name": "keyword.other.storage.st",
          "match": "(?i)\\b(POINTER TO|POINTER|REF(ERENCE)?|REF_TO|OVERLAP|USING|FROM)\\b"
        },
        {
          "name": "storage.type.class.st",
          "match": "(?i)\\b(END_)?(PROGRAM|CLASS|CONFIGURATION|PRIORITY|SINGLE|INTERVAL|TCP|RESOURCE|CHANNEL|LIBRARY|FOLDER|BINARIES|INCLUDES|SOURCES|ACTION|STEP|INITIAL_STEP|TRANSITION|TYPE|FUNCTION|FUNCTION_BLOCK|NAMESPACE|IMPLEMENTATION|INTERFACE|METHOD|CONST|ORGANIZATION_BLOCK|DATA_BLOCK|LABEL)\\b"
        },
        {
          "name": "punctuation.terminator.statement.st",
          "match": "[;]"
        },
        {
          "name": "storage.modifier.st",
          "match": "(?i)\\b(?:ABSTRACT|CONSTANT|RETAIN|PERSISTENT|PUBLIC|PRIVATE|PROTECTED|INTERNAL|FINAL|OVERRIDE)\\b"
        },
        {
          "name": "constant.language.st",
          "match": "(?i)\\b(TRUE|FALSE|NULL|VOID|NIL)\\b"
        },
        {
          "name": "support.type.primitives.st",
          "match": "(?i)\\b(AT|BOOL|BYTE|(?:D|L)?WORD|U?(?:S|D|L)?INT|L?REAL|L?TIME(?:_OF_DAY)?|L?TOD|L?DT|L?DATE(?:_AND_TIME)?|w?STRING|ARRAY|ANY)\\b"
        },
        {
          "match": "(?<=\\.)[A-Za-z_](?:[0-9A-Za-z_])*\\b",
          "name": "variable.parameter.st",
          "comment": "Parameter or an object"
        },
        {
          "name": "support.type.primitives.st",
          "match": "(?i)\\b(ANY_)?(DERIVED|ELEMENTARY|MAGNITUDE|NUM|REAL|INT|UNSIGNED|SIGNED|DURATION|BIT|CHARS|STRING|CHAR|USTRING|UCHAR|DATE)\\b"
        },
        {
          "match": "(?i)\\b(EXTENDS|IMPLEMENTS)\\b",
          "name": "entity.other.inherited-class.st"
        },
        {
          "match": "(?i)\\b(?:THIS|SUPER)\\b",
          "name": "variable.language.st"
        },
        {
          "name": "invalid.st",
          "match": "#"
        },
        {
          "match": "\\b([a-zA-Z0-9_]+)\\b",
          "name": "variable.name.st"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.constant",
          "match": "(?i)\\b(?:L?T|L?DT|L?TOD|L?D)#[0-9\\:\\-\\_shmydSMHDY]+\\b"
        },
        {
          "name": "variable.other.constant",
          "match": "\\b(?:Z|V)[0-9]{1}\\b"
        },
        {
          "name": "variable.other.constant",
          "match": "\\b[A-Za-z]{1,6}#[a-zA-Z0-9\\_]+\\b"
        },
        {
          "name": "variable.other.constant",
          "match": "\\%(I|Q|M|PQ|PI)(X|B|W|D|L)[0-9\\.]+\\b"
        },
        {
          "name": "variable.other.constant",
          "match": "\\%(I|Q)[0-9\\.]+\\b"
        }
      ]
    },
    "meta": {
      "patterns": [
        {
          "name": "meta.expression.st",
          "begin": "(?i)[^a-zA-Z_0-9]+\\((?!\\*)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.parenthesis.begin.st"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.parenthesis.end.st"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "name": "meta.index.st",
          "begin": "\\[",
          "beginCaptures": {
            "0": {
              "name": "punctuation.bracket.begin.st"
            }
          },
          "end": "\\]",
          "endCaptures": {
            "0": {
              "name": "punctuation.bracket.end.st"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "name": "meta.preprocessor.st",
          "begin": "\\{(?=#(?:if|elif|endif)\\b)",
          "beginCaptures": {
            "0": {
              "name": "keyword.control.preprocessor.st"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "keyword.control.preprocessor.st"
            }
          },
          "patterns": [
            {
              "name": "keyword.control.preprocessor.st",
              "match": "#(?:if|elif|endif)\\b"
            },
            {
              "name": "keyword.control.preprocessor.st",
              "match": "\\bis\\b"
            },
            {
              "include": "#keywords"
            }
          ]
        },
        {
          "name": "comment.block.st",
          "begin": "\\{(?!extern|export|test|case|wasm|warn|info|once|allow|#if|#elif|#endif)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.brace.begin.st"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.brace.end.st"
            }
          },
          "patterns": [
            {
              "match": "(attribute|text|info|warning) *('[^']+')(?: *(:=)? * ('[^']+')?)?",
              "captures": {
                "1": {
                  "name": "variable.parameter.st"
                },
                "3": {
                  "name": "keyword.operator.assignment.st"
                },
                "2": {
                  "name": "string.quoted.single.st"
                },
                "4": {
                  "name": "string.quoted.single.st"
                }
              }
            }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "include": "#comment_l"
        },
        {
          "include": "#comment_st"
        },
        {
          "include": "#comment_g"
        }
      ],
      "repository": {
        "comment_l": {
          "name": "comment.line.double-slash.st",
          "begin": "\\/\\/",
          "end": "$",
          "patterns": [
            {
              "include": "#todo"
            },
            {
              "name": "constant.character.escape.st",
              "match": "\\\\."
            }
          ]
        },
        "comment_st": {
          "name": "comment.block.st",
          "begin": "\\(\\*",
          "end": "\\*\\)",
          "patterns": [
            {
              "include": "#todo"
            },
            {
              "include": "#fix"
            },
            {
              "include": "#comment_st"
            },
            {
              "match": "(?i)(@[a-zA-Z_]*)\\s*(:=)\\s+([\"\\']{1}[^\"\\']*[\"\\']{1})",
              "captures": {
                "1": {
                  "name": "variable.parameter.st"
                },
                "2": {
                  "name": "keyword.operator.assignment.st"
                },
                "3": {
                  "name": "string.quoted.single.st"
                }
              }
            }
          ]
        },
        "comment_g": {
          "name": "comment.block.st",
          "begin": "\\/\\*",
          "end": "\\*\\/",
          "patterns": [
            {
              "include": "#todo"
            },
            {
              "include": "#comment_g"
            },
            {
              "_name": "constant.character.escape.st",
              "_match": "\\\\."
            }
          ]
        },
        "todo": {
          "match": "\\b(?:TODO(:)?\\s)",
          "name": "markup.bold keyword.todo.st"
        },
        "fix": {
          "match": "\\b(?:FIX(:)?\\s)",
          "name": "markup.bold keyword.todo.st"
        }
      }
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.st",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.single.begin.st"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.single.end.st"
            }
          },
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        {
          "name": "string.quoted.double.st",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.double.begin.st"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.double.end.st"
            }
          },
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        {
          "name": "string.quoted.double.st",
          "begin": "(?i)\\b(W?STRING)#(\")",
          "beginCaptures": {
            "2": {
              "name": "punctuation.double.begin.st"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.double.end.st"
            }
          },
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        {
          "name": "string.quoted.single.st",
          "begin": "(?i)\\b(W?STRING)#(')",
          "beginCaptures": {
            "2": {
              "name": "punctuation.single.begin.st"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.single.end.st"
            }
          },
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        }
      ],
      "repository": {
        "escape": {
          "name": "constant.character.escape.st",
          "match": "\\$(\\$|'|\"|N|L|R|T|nnnn|nn)"
        }
      }
    }
  },
  "scopeName": "source.st"
}